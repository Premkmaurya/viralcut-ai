# ViralCut AI Configuration
PORT=3001
NODE_ENV=development

# Storage directory (defaults to ./storage relative to server)
STORAGE_DIR=./storage

# FFmpeg and FFprobe binary overrides (leave empty to use bundled or system PATH)
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe

# Speech Recognition Configuration
# Path to 64-bit Python 3.11/3.12 executable with faster-whisper and numpy<2 installed
PYTHON_PATH=./.venv/Scripts/python.exe
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
ALLOW_DEMO_TRANSCRIPT=true

# AI Candidate Scoring Configuration
# Options: heuristic, ollama, custom_llm
AI_SCORER_MODE=heuristic
# Ollama settings (used if AI_SCORER_MODE=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Pipeline Configuration
MAX_CONCURRENT_JOBS=1
CLIP_MIN_DURATION=60
CLIP_MAX_DURATION=180
CLIP_TARGET_MIN_DURATION=60
CLIP_TARGET_MAX_DURATION=90
DEFAULT_ASPECT_RATIO=9:16
OUTPUT_WIDTH=1080
OUTPUT_HEIGHT=1920

# Subtitle Defaults
SUBTITLE_FONT_SIZE=56
SUBTITLE_PRIMARY_COLOR=&H0000FFFF
SUBTITLE_OUTLINE_COLOR=&H00000000
